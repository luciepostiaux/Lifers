APP_NAME=Lifers
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lifers.luciepostiaux.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_BE

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=pusher
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

MAIL_MAILER=smtp
MAIL_HOST=smtp.mail.ovh.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

LEGAL_EDITOR_NAME="Lucie Postiaux"
LEGAL_CONTACT_EMAIL=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=eu
PUSHER_SCHEME=https
PUSHER_PORT=443

VITE_APP_NAME="${APP_NAME}"

# À activer uniquement pendant l'initialisation ponctuelle par la tâche OVH.
LIFERS_HOSTING_BOOTSTRAP_ENABLED=false
